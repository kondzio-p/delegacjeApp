// Baza: Prisma Postgres. Connection string siedzi w prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Konto: logowanie na adres e-mail, którego nie weryfikujemy — dlatego kod
/// odzyskiwania jest jedyną drogą do zapomnianego hasła bez pomocy właściciela.
model User {
  id                   String   @id @default(uuid()) @db.Uuid
  email                String   @unique
  name                 String
  password_hash        String
  recovery_code_hash   String
  is_owner             Boolean  @default(false)
  /// Firma, w której pracuje — ustawiane dopiero po akceptacji przez właściciela.
  company_id           String?  @db.Uuid
  /// Włączane przy resecie hasła przez właściciela; wyłącza je zmiana hasła.
  must_change_password Boolean  @default(false)
  /// Własne kategorie kosztów — zwykła lista tekstów, bez własnych atrybutów.
  expense_categories   String[] @default(["Paliwo", "Jedzenie", "Zakwaterowanie", "Inne"])
  /// Waluta wyświetlania — preferencja konta, nie urządzenia.
  display_currency     String   @default("PLN") @db.VarChar(3)
  /// Język interfejsu — źródło prawdy; ciasteczko jest tylko nośnikiem.
  locale               String   @default("pl") @db.VarChar(5)
  /// Konto zanonimizowane — godziny i wypłaty zostają jako zapis rozliczenia.
  is_deleted           Boolean  @default(false)
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  company          Company?         @relation("CompanyEmployees", fields: [company_id], references: [id], onDelete: SetNull)
  owned_company    Company?         @relation("CompanyOwner")
  join_request     JoinRequest?
  co_ownerships    CompanyCoOwner[]
  co_owner_invites CoOwnerInvite[]
  sessions         Session[]
  trips            Trip[]
  work_entries     WorkEntry[]
  expenses         Expense[]
  payouts          Payout[]

  @@index([company_id])
  @@map("users")
}

/// Firma właściciela; `name_key` to nazwa małymi literami, bo pracownik wpisuje
/// ją ręcznie.
model Company {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  name_key   String   @unique
  owner_id   String   @unique @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  owner            User             @relation("CompanyOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  employees        User[]           @relation("CompanyEmployees")
  join_requests    JoinRequest[]
  co_owners        CompanyCoOwner[]
  co_owner_invites CoOwnerInvite[]

  @@map("companies")
}

/// Prośba pracownika o dołączenie, jedna na konto — czeka na akceptację.
model JoinRequest {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @unique @db.Uuid
  company_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@map("join_requests")
}

/// Współwłaściciel: może wszystko poza skasowaniem firmy i usunięciem
/// założyciela, który siedzi w `Company.owner_id`.
model CompanyCoOwner {
  company_id String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([company_id, user_id])
  @@index([user_id])
  @@map("company_co_owners")
}

/// Zaproszenie do współwłasności — bez akceptacji nie daje żadnego dostępu.
model CoOwnerInvite {
  company_id String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([company_id, user_id])
  @@index([user_id])
  @@map("co_owner_invites")
}

/// Sesja logowania: w bazie leży wyłącznie SHA-256 tokenu z ciasteczka.
model Session {
  token_hash String   @id
  user_id    String   @db.Uuid
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model Trip {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  departure_at  DateTime  @db.Timestamptz(6)
  return_at     DateTime? @db.Timestamptz(6)
  note          String?
  share_token   String    @unique @default(uuid()) @db.Uuid
  share_enabled Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  work_entries WorkEntry[]
  expenses     Expense[]
  payouts      Payout[]

  @@index([user_id, departure_at])
  @@map("trips")
}

/// Czysty zapis czasu; skasowanie podróży odpina wpisy, a nie kasuje.
model WorkEntry {
  id      String  @id @default(uuid()) @db.Uuid
  user_id String  @db.Uuid
  trip_id String? @db.Uuid

  /// Tekst dokładnie w postaci z formularza — kolumny DATE/TIME wymagałyby
  /// konwersji stref tam, gdzie żadna strefa nie jest potrzebna.
  work_date  String   @db.VarChar(10)
  start_time String   @db.VarChar(5)
  end_time   String   @db.VarChar(5)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [trip_id], references: [id], onDelete: SetNull)

  @@index([user_id, work_date])
  @@index([trip_id])
  @@map("work_entries")
}

model Expense {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  trip_id    String?  @db.Uuid
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("EUR") @db.VarChar(3)
  category   String   @default("Inne")
  spent_at   DateTime @default(now()) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  /// Kurs NBP z dnia wpisu; null oznacza brak odpowiedzi NBP przy zapisie.
  nbp_rate      Decimal? @db.Decimal(12, 6)
  /// Data tabeli NBP; bywa wcześniejsza niż wpis, bo w weekendy kursów nie ma.
  nbp_rate_date String?  @db.VarChar(10)

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [trip_id], references: [id], onDelete: SetNull)

  @@index([user_id, spent_at])
  @@index([trip_id])
  @@map("expenses")
}

model Payout {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  trip_id    String?  @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("EUR") @db.VarChar(3)
  note       String?
  paid_at    DateTime @default(now()) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  /// Kurs NBP z dnia wpisu; null oznacza brak odpowiedzi NBP przy zapisie.
  nbp_rate      Decimal? @db.Decimal(12, 6)
  /// Data tabeli NBP; bywa wcześniejsza niż wpis, bo w weekendy kursów nie ma.
  nbp_rate_date String?  @db.VarChar(10)

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [trip_id], references: [id], onDelete: SetNull)

  @@index([user_id, paid_at])
  @@index([trip_id])
  @@map("payouts")
}
