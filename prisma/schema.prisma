// Baza: Prisma Postgres (console.prisma.io).
// Prisma 7 wymaga, żeby connection string siedział w prisma.config.ts, a nie tutaj.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Konto. Logowanie idzie na adres e-mail; `name` to imię lub pseudonim
/// pokazywany w aplikacji i na karcie pracownika.
///
/// Adresu na razie nie weryfikujemy i nic na niego nie wysyłamy — dlatego
/// `recovery_code_hash` zostaje jedyną drogą odzyskania hasła bez pomocy
/// właściciela firmy.
model User {
  id                   String   @id @default(uuid()) @db.Uuid
  email                String   @unique
  name                 String
  password_hash        String
  recovery_code_hash   String
  is_owner             Boolean  @default(false)
  /// Firma, w której pracuje — ustawiane dopiero po akceptacji przez właściciela.
  company_id           String?  @db.Uuid
  /// Włączane przy resecie hasła przez właściciela; wyłącza je zmiana hasła.
  must_change_password Boolean  @default(false)
  /// Własne kategorie kosztów. Zwykła lista tekstów, bo nie mają żadnych
  /// własnych atrybutów — osobna tabela byłaby tu przerostem formy.
  expense_categories   String[] @default(["Paliwo", "Jedzenie", "Zakwaterowanie", "Inne"])
  /// Waluta, w której użytkownik chce widzieć kwoty. Preferencja konta, nie
  /// urządzenia — ma przetrwać wyczyszczenie przeglądarki i wejście z telefonu.
  display_currency     String   @default("PLN") @db.VarChar(3)
  /// Język interfejsu. Ciasteczko jest tylko szybkim nośnikiem dla pierwszego
  /// renderu; źródłem prawdy jest ta kolumna.
  locale               String   @default("pl") @db.VarChar(5)
  /// Konto zanonimizowane na żądanie użytkownika. Dane osobowe zniknęły,
  /// godziny i wypłaty zostały, bo to zapis rozliczenia z firmą.
  is_deleted           Boolean  @default(false)
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  company          Company?         @relation("CompanyEmployees", fields: [company_id], references: [id], onDelete: SetNull)
  owned_company    Company?         @relation("CompanyOwner")
  join_request     JoinRequest?
  co_ownerships    CompanyCoOwner[]
  co_owner_invites CoOwnerInvite[]
  sessions         Session[]
  trips            Trip[]
  work_entries     WorkEntry[]
  expenses         Expense[]
  payouts          Payout[]

  @@index([company_id])
  @@map("users")
}

/// Firma właściciela. `name_key` to nazwa złożona do lowercase — pracownik
/// wpisuje nazwę ręcznie, więc dopasowanie nie może zależeć od wielkości liter.
model Company {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  name_key   String   @unique
  owner_id   String   @unique @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  owner            User             @relation("CompanyOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  employees        User[]           @relation("CompanyEmployees")
  join_requests    JoinRequest[]
  co_owners        CompanyCoOwner[]
  co_owner_invites CoOwnerInvite[]

  @@map("companies")
}

/// Prośba pracownika o dołączenie — czeka na akceptację właściciela.
/// Jedna na użytkownika: nie da się prosić dwóch firm naraz.
model JoinRequest {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @unique @db.Uuid
  company_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@map("join_requests")
}

/// Współwłaściciel firmy. Założyciel siedzi dalej w `Company.owner_id` —
/// ta tabela dokłada pozostałych. Współwłaściciel może wszystko poza
/// skasowaniem firmy i usunięciem założyciela.
model CompanyCoOwner {
  company_id String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([company_id, user_id])
  @@index([user_id])
  @@map("company_co_owners")
}

/// Zaproszenie do współwłasności czekające na akceptację. Dopóki zaproszony
/// nie kliknie „Akceptuj", nie ma żadnego dostępu — dzięki temu literówka
/// w adresie e-mail jest nieszkodliwa.
model CoOwnerInvite {
  company_id String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([company_id, user_id])
  @@index([user_id])
  @@map("co_owner_invites")
}

/// Sesja logowania. Token trafia do ciasteczka httpOnly, w bazie leży wyłącznie
/// jego SHA-256, więc podgląd tabeli nie pozwala podszyć się pod użytkownika.
model Session {
  token_hash String   @id
  user_id    String   @db.Uuid
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model Trip {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  departure_at  DateTime  @db.Timestamptz(6)
  return_at     DateTime? @db.Timestamptz(6)
  note          String?
  share_token   String    @unique @default(uuid()) @db.Uuid
  share_enabled Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  work_entries WorkEntry[]
  expenses     Expense[]
  payouts      Payout[]

  @@index([user_id, departure_at])
  @@map("trips")
}

/// Czysty zapis czasu — żadnych kwot. Pieniądze mieszkają w Expense i Payout.
///
/// ON DELETE SET NULL na trip_id: skasowanie podróży odpina wpisy, nie kasuje ich.
model WorkEntry {
  id      String  @id @default(uuid()) @db.Uuid
  user_id String  @db.Uuid
  trip_id String? @db.Uuid

  /// Data i godziny trzymamy jako tekst ("YYYY-MM-DD", "HH:MM") — dokładnie w tej
  /// postaci, w jakiej wpisuje je formularz. Kolumny DATE/TIME wracałyby ze
  /// sterownika jako obiekty Date i wymagały konwersji stref czasowych tam, gdzie
  /// żadna strefa nie jest potrzebna. Sortowanie leksykograficzne działa poprawnie.
  work_date  String   @db.VarChar(10)
  start_time String   @db.VarChar(5)
  end_time   String   @db.VarChar(5)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [trip_id], references: [id], onDelete: SetNull)

  @@index([user_id, work_date])
  @@index([trip_id])
  @@map("work_entries")
}

model Expense {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  trip_id    String?  @db.Uuid
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("EUR") @db.VarChar(3)
  category   String   @default("Inne")
  spent_at   DateTime @default(now()) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  /// Kurs NBP z dnia tego wpisu: ile PLN za jedną jednostkę `currency`.
  /// Dla kwot w PLN wynosi 1. Null oznacza, że NBP nie odpowiedziało przy
  /// zapisie — wtedy odczyt sięga po kurs bieżący.
  nbp_rate      Decimal? @db.Decimal(12, 6)
  /// Data publikacji tabeli NBP użytej do przeliczenia. Bywa wcześniejsza niż
  /// data wpisu, bo w weekendy i święta kursów się nie publikuje.
  nbp_rate_date String?  @db.VarChar(10)

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [trip_id], references: [id], onDelete: SetNull)

  @@index([user_id, spent_at])
  @@index([trip_id])
  @@map("expenses")
}

model Payout {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  trip_id    String?  @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("EUR") @db.VarChar(3)
  note       String?
  paid_at    DateTime @default(now()) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  /// Kurs NBP z dnia tego wpisu: ile PLN za jedną jednostkę `currency`.
  /// Dla kwot w PLN wynosi 1. Null oznacza, że NBP nie odpowiedziało przy
  /// zapisie — wtedy odczyt sięga po kurs bieżący.
  nbp_rate      Decimal? @db.Decimal(12, 6)
  /// Data publikacji tabeli NBP użytej do przeliczenia. Bywa wcześniejsza niż
  /// data wpisu, bo w weekendy i święta kursów się nie publikuje.
  nbp_rate_date String?  @db.VarChar(10)

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [trip_id], references: [id], onDelete: SetNull)

  @@index([user_id, paid_at])
  @@index([trip_id])
  @@map("payouts")
}
