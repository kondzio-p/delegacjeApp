# Prisma Postgres -> console.prisma.io -> projekt -> Database -> Connect
# Format: postgres://UZYTKOWNIK:HASLO@HOST:PORT/BAZA?sslmode=require
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Adres produkcyjny, pod ktorym stoi aplikacja — uzywany do zbudowania pelnych
# adresow w metadanych (og:image dla Messengera, Facebooka i reszty).
# Na Vercelu mozna to pominac: Next siegnie po VERCEL_PROJECT_PRODUCTION_URL.
# Wypelnij dopiero po podpieciu wlasnej domeny.
# NEXT_PUBLIC_SITE_URL="https://godzio.pl"
